package org.example.state.contract;

// Every v1 construct (ADR-0005): options, fields of each type, modifiers, statements and expressions.
contract Everything(minAda = 2000000, maxDatumBytes = 256, maxValidityMs = 600_000) {
    state owner: Key
    state goal: Int;
    state open_: Bool
    state tag: Bytes
    state points: Map<Key, Int>

    init(goal: Int, tag: Bytes) payable {
        require goal > 0 && tag != #00 "the goal must be positive"
        owner = caller
        this.goal = goal
        this.tag = tag;
        open_ = true
    }

    action tip() payable batched {
        require received >= 1 ada "tip at least 1 ADA"
        goal += received
    }

    action intent() batched only {
        goal -= 1
    }

    action both() batched only owner {
        goal = 0
    }

    action timed(t: Int) after goal before goal {
        require after(t) && before(t + 1) "outside the window"
        let half = (goal + 1) / 2 % 3 * -1
        if half < 0 {
            goal = -half
        } else if !open_ {
            open_ = false
        } else {
            require half >= 0 "never"
        }
        points[caller] += 1
        points[owner] -= 0
        points[#0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c] = 2
        delete points[caller]
    }

    action withdraw(amount: Int) only owner {
        require amount > 0 && amount <= balance || validFrom < validTo "bad amount"
        pay amount to owner
        pay min(1, max(amount, 2)) to caller
    }

    action anyone() open {
        require has(points, caller) == false "no"
    }

    destroy close() only owner {
        require isEmpty(points) "points remain"
        pay balance to owner
    }

    view reached(): Bool = goal >= 10 && this.goal != 3
    view pointsOf(who: Key): Int = points[who];
    view neg(): Int = -(goal - 1)
}
