{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "methods.schema.json",
  "title": "Forward calls and notifications",
  "$defs": {
    "clock": {
      "type": "object",
      "properties": {
        "zeroSlot": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "zeroTimeMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "slotLengthMs": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      },
      "required": ["zeroSlot", "zeroTimeMs", "slotLengthMs"],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "networkId": {"enum": [0, 1]},
        "protocolMagic": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "mainnet": {"type": "boolean"}
      },
      "required": ["networkId", "protocolMagic"],
      "additionalProperties": false,
      "if": {"properties": {"networkId": {"const": 1}}},
      "then": {"required": ["mainnet"], "properties": {"mainnet": {"const": true}}}
    },
    "initialize": {
      "type": "object",
      "properties": {
        "protocol": {"type": "array", "items": {"type": "integer"}},
        "network": {"$ref": "#/$defs/network"},
        "clock": {"$ref": "#/$defs/clock"},
        "time": {
          "type": "object",
          "properties": {
            "maxTtlSlots": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
            "settlementSlots": {"type": "integer", "minimum": 0, "maximum": 100000},
            "maxNowAheadSlots": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
          },
          "required": ["maxTtlSlots", "settlementSlots", "maxNowAheadSlots"],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "readsPerCall": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
            "readBytesPerCall": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
            "callDeadlineMs": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
          },
          "required": ["readsPerCall", "readBytesPerCall", "callDeadlineMs"],
          "additionalProperties": false
        },
        "build": {
          "type": "object",
          "properties": {
            "snapshot": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "required": ["snapshot", "digest"],
          "additionalProperties": false
        },
        "restoring": {"type": "boolean"}
      },
      "required": ["protocol", "network", "clock", "time", "limits", "build", "restoring"],
      "additionalProperties": false
    },
    "designated": {"type": "string", "pattern": "^[0-9a-f]{64}#(0|[1-9][0-9]*)$"},
    "operation": {
      "type": "object",
      "properties": {
        "designated": {"$ref": "#/$defs/designated"},
        "contract": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "instance": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "key": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{2})+$"},
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "txHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "validTo": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
            },
            "required": ["txHash", "validTo"],
            "additionalProperties": false
          }
        }
      },
      "required": ["designated", "contract", "method", "instance", "key", "attempts"],
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "properties": {
        "contract": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "instance": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
        "object": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "args": {"type": "object"},
        "pay": {
          "type": "object",
          "properties": {
            "lovelace": {"oneOf": [{"type": "string", "pattern": "^[0-9]+$"}, {"type": "integer", "minimum": 0}]},
            "assets": {"type": "array", "items": {}}
          },
          "required": [],
          "additionalProperties": false
        },
        "address": {"type": "string", "minLength": 1},
        "designated": {"$ref": "#/$defs/designated"},
        "operation": {"$ref": "#/$defs/operation"},
        "pageLimits": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}]
        },
        "cosigners": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{56}$"}}
      },
      "required": ["contract", "kind", "method", "args", "address"],
      "additionalProperties": false
    },
    "prepare": {
      "type": "object",
      "properties": {
        "now": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "ttlSlots": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "call": {"$ref": "#/$defs/call"}
      },
      "required": ["now", "ttlSlots", "call"],
      "additionalProperties": false
    },
    "describe": {
      "type": "object",
      "properties": {"contract": {"type": "string", "minLength": 1}},
      "required": ["contract"],
      "additionalProperties": false
    },
    "settled": {
      "type": "object",
      "properties": {
        "reservation": {"type": "string", "minLength": 1},
        "txHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["confirmed", "rolledBack", "expired", "discarded"]},
        "tip": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "slot": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      },
      "required": ["reservation", "txHash", "status", "tip"],
      "additionalProperties": false,
      "if": {"properties": {"status": {"const": "confirmed"}}},
      "then": {"required": ["slot"]},
      "else": {"not": {"required": ["slot"]}}
    },
    "restore": {
      "type": "object",
      "properties": {
        "transactions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "operation": {"$ref": "#/$defs/operation"},
                  "cbor": {"type": "string", "pattern": "^(?:[a-fA-F0-9]{2})+$"},
                  "state": {"const": "prepared"}
                },
                "required": ["cbor", "state"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "operation": {"$ref": "#/$defs/operation"},
                  "cbor": {"type": "string", "pattern": "^(?:[a-fA-F0-9]{2})+$"},
                  "state": {"const": "shallow"},
                  "slot": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
                },
                "required": ["cbor", "state", "slot"],
                "additionalProperties": false
              }
            ]
          }
        },
        "complete": {"type": "boolean"}
      },
      "required": ["transactions", "complete"],
      "additionalProperties": false
    },
    "reset": {
      "type": "object",
      "properties": {
        "now": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "clock": {"$ref": "#/$defs/clock"},
        "rewound": {
          "type": "object",
          "properties": {"tip": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}},
          "required": ["tip"],
          "additionalProperties": false
        }
      },
      "required": ["now"],
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "now": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "contract": {"type": "string", "minLength": 1}
      },
      "required": ["now", "contract"],
      "additionalProperties": false
    },
    "prerequisites": {"$ref": "#/$defs/deployment"},
    "publish": {
      "type": "object",
      "properties": {
        "now": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "contract": {"type": "string", "minLength": 1},
        "ttlSlots": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "prerequisite": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1}
      },
      "required": ["now", "contract", "ttlSlots", "prerequisite", "address"],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "now": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "contract": {"type": "string", "minLength": 1},
        "instance": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "view": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "args": {"type": "object"}
      },
      "required": ["now", "contract", "instance", "view", "args"],
      "additionalProperties": false
    },
    "cursor": {
      "type": "object",
      "properties": {
        "listing": {"type": "string", "minLength": 1},
        "after": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500}
      },
      "required": ["listing", "after", "limit"],
      "additionalProperties": false
    },
    "instances": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "now": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            "contract": {"type": "string", "minLength": 1},
            "limit": {"type": "integer", "minimum": 1, "maximum": 500}
          },
          "required": ["now", "contract", "limit"],
          "additionalProperties": false
        },
        {"$ref": "#/$defs/cursor"}
      ]
    },
    "objects": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "now": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            "contract": {"type": "string", "minLength": 1},
            "instance": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "limit": {"type": "integer", "minimum": 1, "maximum": 500}
          },
          "required": ["now", "contract", "instance", "limit"],
          "additionalProperties": false
        },
        {"$ref": "#/$defs/cursor"}
      ]
    },
    "decode": {
      "type": "object",
      "properties": {
        "contract": {"type": "string", "minLength": 1},
        "datum": {"type": "string", "pattern": "^(?:[a-fA-F0-9]{2})+$"}
      },
      "required": ["contract", "datum"],
      "additionalProperties": false
    },
    "registered": {
      "type": "object",
      "properties": {
        "credential": {"type": "string", "pattern": "^[0-9a-f]{56}$"},
        "evidence": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "txHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "message": {"type": "string", "minLength": 1}
              },
              "required": ["txHash", "message"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "txHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "slot": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
              },
              "required": ["txHash", "slot"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["credential", "evidence"],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "initialize"},
        "params": {"$ref": "#/$defs/initialize"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "describe"},
        "params": {"$ref": "#/$defs/describe"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "prepare"},
        "params": {"$ref": "#/$defs/prepare"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "settled"},
        "params": {"$ref": "#/$defs/settled"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "restore"},
        "params": {"$ref": "#/$defs/restore"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "reset"},
        "params": {"$ref": "#/$defs/reset"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "deployment"},
        "params": {"$ref": "#/$defs/deployment"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "prerequisites"},
        "params": {"$ref": "#/$defs/prerequisites"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "publish"},
        "params": {"$ref": "#/$defs/publish"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "view"},
        "params": {"$ref": "#/$defs/view"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "instances"},
        "params": {"$ref": "#/$defs/instances"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "objects"},
        "params": {"$ref": "#/$defs/objects"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "decode"},
        "params": {"$ref": "#/$defs/decode"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "registered"},
        "params": {"$ref": "#/$defs/registered"}
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"const": "shutdown"},
        "params": {"type": "object", "properties": {}, "required": [], "additionalProperties": false}
      },
      "required": ["jsonrpc", "id", "method"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "method": {"const": "$/cancelRequest"},
        "params": {
          "type": "object",
          "properties": {"id": {"type": ["string", "integer"]}},
          "required": ["id"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "method": {"const": "exit"},
        "params": {"type": "object", "properties": {}, "required": [], "additionalProperties": false}
      },
      "required": ["jsonrpc", "method"],
      "additionalProperties": false
    }
  ]
}
