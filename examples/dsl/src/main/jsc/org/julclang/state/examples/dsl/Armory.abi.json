      { "name": "Take", "constr": 2, "fields": [
          { "name": "item", "type": "Bytes", "data": "bytes" },
          { "name": "count", "type": "Int", "data": "int" }
        ] },
      { "name": "CloseVault", "constr": 3, "fields": [
          { "name": "ctx", "type": "Ctx", "data": "Ctx" }
        ] }
    ],
    "mint": [
