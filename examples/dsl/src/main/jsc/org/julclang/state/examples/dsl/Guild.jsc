jsc 2
package org.julclang.state.examples.dsl

// examples/guild's Guild in .jsc 2 (ADR-0018 M3a, J11; ADR-0012): a game guild with two kinds of owned objects, heroes
// and items. Each object is its own UTxO, typed by its datum's constructor, so a hero's methods never run on an item. A
// hero can move to another guild: the destination admits it in the same transaction, and the source must be open for it
// to leave. Vaults, whose inventories are BigMaps, are a separate contract (Armory) so that each script stays small.
contract Guild(maxDatumBytes = 160) {
  state { master: Key, isOpen: Bool, arrivals: Int, minLevel: Int }

  owned Hero { owner: Key, level: Int }
  owned Item { owner: Key, power: Int }

  init(minLevel: Int) {
    require(minLevel > 0, "the minimum level must be positive")
    return { master: caller, isOpen: true, arrivals: 0, minLevel }
  }

  action setOpen(nowOpen: Bool) only master {
    return { ...state, isOpen: nowOpen }
  }

  // Admits a hero moving in from another guild (the other half of transfer). It sees the arriving hero, read on-chain
  // from the hero's own input, and admits only heroes of at least the guild's level.
  action admit(heroId: Bytes, hero: Hero) admits Hero {
    require(isOpen, "the guild is closed")
    require(hero.level >= minLevel, "the hero's level is too low for this guild")
    return { ...state, arrivals: arrivals + 1 }
  }

  // Admits an item carried in from another guild (the other half of carry); items do not count.
  action admitItem(item: Bytes) admits Item {
    require(isOpen, "the guild is closed")
    return state
  }

  // ---- heroes

  owned init Hero.recruit(guild: shared) {
    require(guild.isOpen, "the guild is closed")
    return { owner: caller, level: 1 }
  }

  owned action Hero.levelUp() only owner {
    return { ...state, level: level + 1 }
  }

  // Moves the hero to destination, which must admit it; only from an open guild, and only from level 2.
  owned action Hero.transfer(source: shared, destination: into) only owner {
    require(source.isOpen, "the source guild is closed")
    require(level >= 2, "a hero moves from level 2")
    return state
  }

  owned destroy Hero.retire() only owner {
    pay(owner, balance)
  }

  // ---- items

  owned init Item.forge(guild: shared, power: Int) {
    require(guild.isOpen, "the guild is closed")
    require(power > 0 && power <= 10, "a new item has power 1 to 10")
    return { owner: caller, power }
  }

  owned action Item.enchant(by: Int) only owner {
    require(by > 0, "enchant by a positive amount")
    return { ...state, power: power + by }
  }

  // Carries the item to destination, which must admit it with admitItem.
  owned action Item.carry(destination: into) only owner {
    return state
  }

  owned destroy Item.scrap() only owner {
    pay(owner, balance)
  }

  // ---- invariants, by type

  invariant Hero.heroLevel = level > 0
  invariant Item.itemPower = power <= 100

  view open(): Bool = isOpen
}
