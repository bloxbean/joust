jsc 2
package org.julclang.state.examples.dsl

// examples/guild's Armory in .jsc 2 (ADR-0018 M3a, J11; ADR-0012 D2): player vaults, each an owned object whose
// inventory, of any size, is a BigMap. Its datum holds only the root; each call's reads and writes are proven to the
// shared map verifier, keyed by the vault's own input, as an instance's maps are.
contract Armory(maxDatumBytes = 160) {
  state { keeper: Key, isOpen: Bool }

  // A player's vault: an inventory (item name -> count) of any size.
  owned Vault { owner: Key, kinds: Int, inventory: BigMap<Bytes, Int> }

  init() {
    return { keeper: caller, isOpen: true }
  }

  action setOpen(nowOpen: Bool) only keeper {
    return { ...state, isOpen: nowOpen }
  }

  owned init Vault.openVault(armory: shared) {
    require(armory.isOpen, "the armory is closed")
    return { owner: caller, kinds: 0, inventory: BigMap.empty() }
  }

  owned action Vault.stash(item: Bytes, count: Int) only owner {
    require(count > 0, "stash a positive count")
    const have = inventory[item]
    return { ...state, kinds: have == 0 ? kinds + 1 : kinds, inventory: inventory.set(item, have + count) }
  }

  owned action Vault.take(item: Bytes, count: Int) only owner {
    const have = inventory[item]
    require(count > 0 && count <= have, "not that many in the vault")
    const left = have - count
    return { ...state, kinds: left == 0 ? kinds - 1 : kinds, inventory: inventory.set(item, left) }
  }

  // Closes an empty vault (no shared: it works whatever the armory's state).
  owned destroy Vault.closeVault() only owner {
    require(kinds == 0, "empty the vault first")
    pay(owner, balance)
  }
}
