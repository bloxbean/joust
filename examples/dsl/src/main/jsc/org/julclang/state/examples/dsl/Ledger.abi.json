        ] },
      { "name": "Mint", "constr": 3, "fields": [
          { "name": "to", "type": "Key", "data": "bytes28" },
          { "name": "amount", "type": "Int", "data": "int" }
        ] },
      { "name": "Transfer", "constr": 4, "fields": [
          { "name": "to", "type": "Key", "data": "bytes28" },
          { "name": "amount", "type": "Int", "data": "int" },
          { "name": "ctx", "type": "Ctx", "data": "Ctx" }
        ] },
      { "name": "Settle", "constr": 5, "fields": [
