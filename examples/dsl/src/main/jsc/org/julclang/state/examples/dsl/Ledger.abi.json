        ] }
    ],
    "mint": [
      { "name": "CreateInstance", "constr": 0, "fields": [
          { "name": "seed", "type": "TxOutRef", "data": "TxOutRef" },
          { "name": "limits", "type": "Map<Key, Int>", "data": "map<bytes28, int>" },
          { "name": "ctx", "type": "Ctx", "data": "Ctx" }
        ] },
      { "name": "BurnInstance", "constr": 1, "fields": [] }
    ]
