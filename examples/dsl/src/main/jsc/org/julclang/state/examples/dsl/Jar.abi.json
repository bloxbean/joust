{
  "abi": 2,
  "contract": "org.julclang.state.examples.dsl.Jar",
  "source": "Jar.jsc",
  "datum": { "name": "State", "constr": 0, "fields": [
      { "name": "owner", "type": "Key", "data": "bytes28" },
      { "name": "goal", "type": "Int", "data": "int" },
      { "name": "total", "type": "Int", "data": "int" },
      { "name": "tips", "type": "Int", "data": "int" }
    ] },
  "intent": { "datum": "Intent", "refund": "IntentRefund" },
  "redeemers": {
    "spend": [
      { "name": "Tip", "constr": 0, "fields": [
          { "name": "ctx", "type": "Ctx", "data": "Ctx" }
        ] },
      { "name": "Withdraw", "constr": 1, "fields": [
          { "name": "amount", "type": "Int", "data": "int" },
          { "name": "ctx", "type": "Ctx", "data": "Ctx" }
        ] },
      { "name": "Close", "constr": 2, "fields": [
          { "name": "ctx", "type": "Ctx", "data": "Ctx" }
        ] },
      { "name": "Batch", "constr": 3, "fields": [
          { "name": "validFrom", "type": "Int", "data": "int" },
          { "name": "validTo", "type": "Int", "data": "int" }
        ] },
      { "name": "InBatch", "constr": 4, "fields": [] },
      { "name": "CancelIntent", "constr": 5, "fields": [] }
    ],
    "mint": [
      { "name": "CreateInstance", "constr": 0, "fields": [
          { "name": "seed", "type": "TxOutRef", "data": "TxOutRef" },
          { "name": "goal", "type": "Int", "data": "int" },
          { "name": "ctx", "type": "Ctx", "data": "Ctx" }
        ] },
      { "name": "BurnInstance", "constr": 1, "fields": [] },
      { "name": "CreateIntent", "constr": 2, "fields": [
          { "name": "seed", "type": "TxOutRef", "data": "TxOutRef" },
          { "name": "intent", "type": "Intent", "data": "Intent" }
        ] }
    ]
  },
  "types": {
    "Intent": { "kind": "validator", "constructors": [{ "name": "Intent", "constr": 0, "fields": [
        { "name": "instance", "type": "Bytes", "data": "bytes" },
        { "name": "owner", "type": "Key", "data": "bytes28" },
        { "name": "refund", "type": "Address", "data": "Address" },
        { "name": "deadline", "type": "Int", "data": "int" },
        { "name": "received", "type": "Int", "data": "int" },
        { "name": "call", "type": "IntentCall", "data": "IntentCall" }
      ] }] },
    "IntentCall": { "kind": "validator", "constructors": [
      { "name": "TipIntent", "constr": 0, "fields": [] }
    ] },
    "IntentRefund": { "kind": "validator", "constructors": [{ "name": "IntentRefund", "constr": 0, "fields": [
        { "name": "intent", "type": "TxOutRef", "data": "TxOutRef" }
      ] }] },
    "Address": { "kind": "ledger", "constructors": [{ "name": "Address", "constr": 0, "fields": [
        { "name": "credential", "type": "Credential", "data": "Credential" },
        { "name": "stakingCredential", "type": "Option<StakingCredential>", "data": "option<StakingCredential>" }
      ] }] },
    "Credential": { "kind": "ledger", "constructors": [
      { "name": "PubKeyCredential", "constr": 0, "fields": [
          { "name": "hash", "type": "Bytes", "data": "bytes" }
        ] },
      { "name": "ScriptCredential", "constr": 1, "fields": [
          { "name": "hash", "type": "Bytes", "data": "bytes" }
        ] }
    ] },
    "StakingCredential": { "kind": "ledger", "constructors": [
      { "name": "StakingHash", "constr": 0, "fields": [
          { "name": "credential", "type": "Credential", "data": "Credential" }
        ] },
      { "name": "StakingPtr", "constr": 1, "fields": [
          { "name": "slot", "type": "Int", "data": "int" },
          { "name": "txIndex", "type": "Int", "data": "int" },
          { "name": "certIndex", "type": "Int", "data": "int" }
        ] }
    ] },
    "Ctx": { "kind": "api", "constructors": [{ "name": "Ctx", "constr": 0, "fields": [
        { "name": "caller", "type": "Key", "data": "bytes28" },
        { "name": "received", "type": "Int", "data": "int" },
        { "name": "balance", "type": "Int", "data": "int" },
        { "name": "validFrom", "type": "Int", "data": "int" },
        { "name": "validTo", "type": "Int", "data": "int" }
      ] }] },
    "TxOutRef": { "kind": "ledger", "constructors": [{ "name": "TxOutRef", "constr": 0, "fields": [
        { "name": "txId", "type": "Bytes", "data": "bytes" },
        { "name": "index", "type": "Int", "data": "int" }
      ] }] }
  },
  "timeFields": []
}
