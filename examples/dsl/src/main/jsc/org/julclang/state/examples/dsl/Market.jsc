jsc 2
package org.julclang.state.examples.dsl

// examples/market in .jsc 2 (ADR-0018 M3a, J11; ADR-0007, ADR-0012 D3): an NFT marketplace. Each listing is an owned
// object that holds the NFT it sells, so listings never contend. A purchase ends the listing: the seller is paid, the
// NFT goes to the buyer and the royalty to the collection's royalty script, with an inline datum naming the NFT. The
// seller can always take the NFT back, whatever the market's state (cancel, the escape hatch).
contract Market(maxDatumBytes = 384, assetSlots = 1) {
  // The market: its admin and fee, and where royalties go (examples/market's Config).
  state { admin: Key, feeBps: Int, royaltyVault: Address, royaltyBps: Int, paused: Bool }

  owned Listing { seller: Key, nftPolicy: Hash, nftName: Bytes, price: Int }

  // The royalty output's datum: which NFT sold, and for how much.
  type Royalty = { nftPolicy: Hash, nftName: Bytes, price: Int }

  init(feeBps: Int, royaltyVault: Address, royaltyBps: Int) {
    require(feeBps >= 0 && royaltyBps >= 0 && feeBps + royaltyBps < 10_000, "fees must leave the seller something")
    return { admin: caller, feeBps, royaltyVault, royaltyBps, paused: false }
  }

  action setPaused(pause: Bool) only admin {
    return { ...state, paused: pause }
  }

  // Offers one NFT at price: the listing takes the NFT in.
  owned init Listing.offer(market: shared, nftPolicy: Hash, nftName: Bytes, price: Int) payable {
    require(!market.paused, "the market is paused")
    require(price >= 2_000_000, "price below 2 ADA")
    require(received == 0, "a listing takes the NFT, not ADA")
    accept(Value.asset(nftPolicy, nftName, 1))
    return { seller: caller, nftPolicy, nftName, price }
  }

  // Buys a listing: pays exactly its price, receives the NFT.
  owned destroy Listing.buy(market: shared) payable open {
    require(!market.paused, "the market is paused")
    require(received == price, "pay exactly the price")
    require(caller != seller, "the seller cannot buy their own listing")
    const fee = price * market.feeBps / 10_000
    const royalty = price * market.royaltyBps / 10_000
    // The seller gets the price less fee and royalty, plus the listing's deposit (balance).
    pay(seller, price - fee - royalty + balance)
    // A zero fee pays nothing (pay skips a zero amount), as examples/market's fee.signum() > 0 does.
    pay(market.admin, fee)
    send(wallet(caller), funds.held)
    if royalty > 0 { send(market.royaltyVault, Value.lovelace(royalty), Royalty { nftPolicy, nftName, price }) }
    accept(Value.none())
  }

  // Moves a listing, NFT included, to another market at a new price (ADR-0012 D3): the destination admits it with enlist.
  owned action Listing.relist(to: into, newPrice: Int) only seller {
    require(newPrice >= 2_000_000, "price below 2 ADA")
    return { ...state, price: newPrice }
  }

  // Admits a listing relisted from another market, unless this market is paused.
  action enlist(listingId: Bytes) admits Listing {
    require(!paused, "the market is paused")
    return state
  }

  // The seller takes the NFT back. Reads no market state, so it works even if the market is paused.
  owned destroy Listing.cancel() only seller {
    pay(seller, balance)
    send(wallet(seller), funds.held)
  }
}
