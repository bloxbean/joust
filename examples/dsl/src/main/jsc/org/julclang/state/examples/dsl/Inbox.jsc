jsc 2
package org.julclang.state.examples.dsl

// ADR-0018 M2c (review r1, S1, F5, C1): a receiver whose memo holds every shape a generated memo decoder decides on the
// data: a Bool, an Option, an enum (a variant without fields and one with), a List, a Map, a Value and an Address. Also
// two receiving actions whose memo types share a Java representation (Key and Bytes) but not a decoder, and a Value memo
// the action never reads. And an action that stores a Bool, an Option and an enum argument in the state: the premise of
// ADR-0018 D5's trusted read states (a .jsc validator never writes a malformed tag; review r1, F4). Not an example to
// deploy: the five-way and the hostile-input tests' fixture.
enum Kind { Plain, Bonus { factor: Int } }

type Slip = { urgent: Bool, ref: Option<Int>, kind: Kind, tags: List<Bytes>, shares: Map<Key, Int>, extra: Value, reply: Address }

contract Inbox(maxDatumBytes = 512) {
  state { owner: Key, urgent: Int, refs: Int, bonus: Int, tags: Int, shares: Int, extra: Int, reply: Option<Address>, keys: Int, names: Int,
    flag: Bool, pick: Option<Int>, kind: Kind }

  init() {
    return { owner: caller, urgent: 0, refs: 0, bonus: 0, tags: 0, shares: 0, extra: 0, reply: None, keys: 0, names: 0, flag: false, pick: None, kind: Plain }
  }

  // Each slip's fields, folded into the counters: every part of the memo is read.
  action post() receives Slip {
    require(!funds.deposits.isEmpty, "nothing deposited")
    return funds.deposits.fold(state, (st, d) => ({
      ...st,
      urgent: st.urgent + if d.memo.urgent { 1 } else { 0 },
      refs: st.refs + (d.memo.ref ?? 0),
      bonus: st.bonus + match d.memo.kind {
        Bonus { factor } => factor
        Plain => 0
      },
      tags: st.tags + d.memo.tags.length,
      shares: d.memo.shares.fold(st.shares, (x, k, v) => x + v),
      extra: st.extra + d.memo.extra.lovelace,
      reply: Some(d.memo.reply)
    }))
  }

  // A Key memo: 28 bytes, checked (#memo:).
  action keyed() receives Key {
    return { ...state, keys: keys + funds.deposits.length }
  }

  // A Bytes memo: any bytes.
  action named() receives Bytes {
    return { ...state, names: names + funds.deposits.length }
  }

  // A Value memo, never read: still decoded and checked (#memo:, review r1 C2).
  action valued() receives Value {
    return { ...state, names: names + funds.deposits.length }
  }

  // Arguments stored as they come: a Bool, an Option and an enum (each decided by the validator on the redeemer's data).
  action set(newFlag: Bool, newPick: Option<Int>, newKind: Kind) only owner {
    return { ...state, flag: newFlag, pick: newPick, kind: newKind }
  }

  destroy close() only owner {
    pay(owner, balance)
  }
}
