{
  "name": "vscode-joust",
  "displayName": "JOUST .jsc",
  "description": "JOUST's contract language, .jsc 2, in VS Code: diagnostics as you type from the build's own front end (with recovery), hover, go to definition, references, completion, rename, semantic highlighting, the outline, folding, quick fixes, the generated Java, build diagnostics on save, Accept ABI…, and JOUST: Build with clickable build errors (ADR-0021). Language preview.",
  "version": "0.1.0",
  "private": true,
  "preview": true,
  "license": "MIT",
  "publisher": "joust-q4-undecided",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxbean/joust.git",
    "directory": "js/vscode-joust"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "cardano",
    "joust",
    "jsc",
    "smart contracts"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:jsc",
    "workspaceContains:joust.config.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the bundled compiler analyses .jsc files (advisory): no project code runs and no build task is offered.",
      "restrictedConfigurations": [
        "joust.allowedProjectRoots"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "jsc",
        "aliases": [
          ".jsc",
          "jsc",
          "JOUST"
        ],
        "extensions": [
          ".jsc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jsc",
        "scopeName": "source.jsc",
        "path": "./syntaxes/jsc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "jsc",
        "path": "./snippets/jsc.json"
      }
    ],
    "commands": [
      {
        "command": "joust.restartAnalysis",
        "title": "Restart analysis",
        "category": "JOUST"
      },
      {
        "command": "joust.restartServer",
        "title": "Restart server",
        "category": "JOUST"
      },
      {
        "command": "joust.build",
        "title": "Build",
        "category": "JOUST"
      },
      {
        "command": "joust.showCompiler",
        "title": "Show compiler and mode",
        "category": "JOUST"
      },
      {
        "command": "joust.applyFix",
        "title": "Apply a JOUST quick fix",
        "category": "JOUST"
      },
      {
        "command": "joust._status",
        "title": "JOUST status (internal)",
        "category": "JOUST"
      },
      {
        "command": "joust.renameSymbol",
        "title": "Rename Symbol",
        "category": "JOUST"
      },
      {
        "command": "joust.removeInvisible",
        "title": "Remove invisible characters…",
        "category": "JOUST"
      },
      {
        "command": "joust.showGeneratedJava",
        "title": "Show generated Java",
        "category": "JOUST"
      },
      {
        "command": "joust.peekGeneratedJava",
        "title": "Peek generated Java",
        "category": "JOUST"
      },
      {
        "command": "joust.checkBuild",
        "title": "Check build (in memory)",
        "category": "JOUST"
      },
      {
        "command": "joust.acceptAbi",
        "title": "Accept ABI…",
        "category": "JOUST"
      },
      {
        "command": "joust.addImport",
        "title": "Add a JOUST import",
        "category": "JOUST"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "joust.applyFix",
          "when": "false"
        },
        {
          "command": "joust._status",
          "when": "false"
        },
        {
          "command": "joust.build",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "joust.addImport",
          "when": "false"
        },
        {
          "command": "joust.acceptAbi",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "joust.renameSymbol",
          "when": "editorLangId == jsc"
        },
        {
          "command": "joust.removeInvisible",
          "when": "editorLangId == jsc"
        },
        {
          "command": "joust.showGeneratedJava",
          "when": "editorLangId == jsc"
        },
        {
          "command": "joust.peekGeneratedJava",
          "when": "editorLangId == jsc"
        },
        {
          "command": "joust.checkBuild",
          "when": "editorLangId == jsc"
        }
      ]
    },
    "configuration": {
      "title": "JOUST",
      "properties": {
        "joust.allowedProjectRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Absolute paths of folders a .code-workspace file lists outside its own directory whose project compiler may still be loaded (ADR-0021 D3b). User settings only."
        },
        "joust.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Traces the messages between VS Code and the JOUST language server."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "joust",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "build",
              "abi diff",
              "accept abi"
            ],
            "description": "The project command: build (joust build, or ./gradlew build); abi diff and accept abi run from Accept ABI…."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "joust",
        "owner": "joust",
        "source": "joust build",
        "fileLocation": [
          "search",
          {
            "include": [
              "${workspaceFolder}"
            ],
            "exclude": [
              "${workspaceFolder}/node_modules",
              "${workspaceFolder}/build"
            ]
          }
        ],
        "pattern": {
          "regexp": "^(.+?\\.(?:jsc|java)):(\\d+)(?::(\\d+))?: (error|warning|note)(?:\\[(JSC\\d{4})\\])?: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "keybindings": [
      {
        "command": "joust.renameSymbol",
        "key": "f2",
        "when": "editorTextFocus && editorLangId == jsc && !editorReadonly"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "timeValue",
        "description": "A time value (ADR-0018 D11): it depends on the validity window or a time state field"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "jsc",
        "scopes": {
          "*.timeValue": [
            "markup.italic"
          ]
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && vsce package --pre-release --no-dependencies --out vscode-joust.vsix && node scripts/check-vsix.mjs vscode-joust.vsix",
    "test": "node --test test/*.test.mjs",
    "test:electron": "node test/electron/run.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "vscode-languageclient": "11.0.0",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
