{
  "name": "@julclang/joust-runtime",
  "version": "0.1.0",
  "description": "JOUST off-chain runtime for JavaScript: prepares contract calls in a Wasm engine (no JVM), from the chain as a Blockfrost-style API serves it; the page verifier checks every transaction before a wallet signs (ADR-0015)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "engine"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@julclang/state-client": "0.1.0"
  },
  "peerDependencies": {
    "@emurgo/cardano-serialization-lib-nodejs": "15.0.3",
    "@emurgo/cardano-serialization-lib-browser": "15.0.3"
  },
  "peerDependenciesMeta": {
    "@emurgo/cardano-serialization-lib-nodejs": {
      "optional": true
    },
    "@emurgo/cardano-serialization-lib-browser": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
